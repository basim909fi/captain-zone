<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الطبقة 1: الزجاج المدخن شبه الشفاف (75% عتامة تظهر خلفية الجوال بنعومة بدون تشويش) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="135"
                android:startColor="#CC182333"
                android:centerColor="#BF121A26"
                android:endColor="#CC0E141F" />
        </shape>
    </item>

    <!-- الطبقة 2: لمعة الانعكاس الزجاجي العلوية المتلاشية (Frosted Glass Sheen) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#2EFFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- الطبقة 3: الإطار الكريستالي الزجاجي المشطوف (Beveled Glass Rim) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1.3dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
