<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الطبقة 1: الزجاج الشفاف الملون (يسمح بمرور خلفية الجوال من تحته بنعومة) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="135"
                android:startColor="#59445B7A"
                android:centerColor="#40253448"
                android:endColor="#4D16202E" />
        </shape>
    </item>

    <!-- الطبقة 2: لمعة الانعكاس الزجاجي العلوية المتلاشية (Frosted Glass Sheen) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- الطبقة 3: الإطار الكريستالي الناعم المضيء (White Glass Rim) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1.3dp"
                android:color="#73FFFFFF" />
        </shape>
    </item>
</layer-list>
