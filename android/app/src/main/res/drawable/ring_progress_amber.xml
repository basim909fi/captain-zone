<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- مسار الحلقة الدائري الثابت -->
    <item android:id="@android:id/background">
        <shape
            android:innerRadiusRatio="2.8"
            android:shape="ring"
            android:thickness="5dp"
            android:useLevel="false">
            <solid android:color="#232A37" />
        </shape>
    </item>
    <!-- مؤشر النسبة المتوهج المتغير -->
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:toDegrees="270">
            <shape
                android:innerRadiusRatio="2.8"
                android:shape="ring"
                android:thickness="5dp"
                android:useLevel="true">
                <gradient
                    android:centerColor="@color/bento_amber"
                    android:endColor="@color/bento_amber_light"
                    android:startColor="@color/bento_amber"
                    android:type="sweep" />
            </shape>
        </rotate>
    </item>
</layer-list>
