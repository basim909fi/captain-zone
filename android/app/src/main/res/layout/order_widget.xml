<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layoutDirection="rtl"
    android:gravity="center_vertical">

    <!-- Right Column: Main Counter & Shift Info (Weight 1.25) -->
    <LinearLayout
        android:id="@+id/widget_main_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingRight="6dp">

        <!-- Header: App Name & Shift Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginLeft="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="كابتن زون"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:textSize="11sp"/>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Status Pill -->
            <TextView
                android:id="@+id/widget_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_closed"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="الوردية مغلقة ⚪"
                android:textColor="#B0BEC5"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Big Orders Counter -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/widget_today_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" طلبات"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="4dp"/>
        </LinearLayout>

        <!-- Subtarget text -->
        <TextView
            android:id="@+id/widget_today_target_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="التارجت اليومي: 16 طلب"
            android:textColor="#D4AF37"
            android:textSize="10sp"
            android:layout_marginBottom="4dp"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar"
            android:layout_marginBottom="6dp"/>

        <!-- Today Expected Income -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="دخل اليوم: "
                android:textColor="#80FFFFFF"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/widget_today_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 ر.س"
                android:textColor="#2FBE77"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Subtle Vertical Divider -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#1AFFFFFF"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"/>

    <!-- Left Column: Interactive Controls & Monthly Stats (Weight 0.95) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.95"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="2dp">

        <!-- Quick Interaction Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تسجيل سريع ⚡"
            android:textColor="#D4AF37"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <!-- Interactive Buttons Row (+ and -) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <!-- Increment Button (+) -->
            <TextView
                android:id="@+id/widget_btn_plus"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_add"
                android:gravity="center"
                android:text="+"
                android:textColor="#1A1612"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"/>

            <!-- Decrement Button (-) -->
            <TextView
                android:id="@+id/widget_btn_minus"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_sub"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Monthly Net Card -->
        <LinearLayout
            android:id="@+id/widget_month_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_glass"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_month_name_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صافي الشهر"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"/>

            <TextView
                android:id="@+id/widget_month_net"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 ر.س"
                android:textColor="#2FBE77"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
