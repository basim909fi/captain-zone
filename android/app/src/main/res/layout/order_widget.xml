<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layoutDirection="rtl"
    android:gravity="center_vertical">

    <!-- Right Column: Main Counter & Shift Info -->
    <LinearLayout
        android:id="@+id/widget_main_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingRight="2dp">

        <!-- Header: App Name & Shift Status Pill together -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginLeft="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="كابتن زون"
                android:textColor="#FBBF24"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginLeft="8dp"/>

            <!-- Status Pill right next to title -->
            <TextView
                android:id="@+id/widget_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_closed"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="الوردية مغلقة ⚪"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Big Orders Counter -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/widget_today_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" طلب اليوم"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="5dp"/>
        </LinearLayout>

        <!-- Subtarget text -->
        <TextView
            android:id="@+id/widget_today_target_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="التارجت اليومي: 16 طلب"
            android:textColor="#FBBF24"
            android:textSize="10sp"
            android:layout_marginBottom="3dp"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar"
            android:layout_marginBottom="5dp"/>

        <!-- Today Expected Income -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="دخل اليوم: "
                android:textColor="#94A3B8"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/widget_today_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 ر.س"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Spacer between columns -->
    <FrameLayout
        android:layout_width="12dp"
        android:layout_height="match_parent"/>

    <!-- Left Column: Interactive Controls & Monthly Stats -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Quick Interaction Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تسجيل سريع ⚡"
            android:textColor="#FBBF24"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>

        <!-- Interactive Buttons Row (+ and -) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">

            <!-- Increment Button (+) -->
            <TextView
                android:id="@+id/widget_btn_plus"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_btn_add"
                android:gravity="center"
                android:text="+"
                android:textColor="#181100"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginLeft="8dp"/>

            <!-- Decrement Button (-) -->
            <TextView
                android:id="@+id/widget_btn_minus"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_btn_sub"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Monthly Net Card -->
        <LinearLayout
            android:id="@+id/widget_month_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_glass"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_month_name_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صافي الشهر"
                android:textColor="#94A3B8"
                android:textSize="9sp"/>

            <TextView
                android:id="@+id/widget_month_net"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 ر.س"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
