<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apple_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_apple_glass_container"
    android:orientation="horizontal"
    android:layoutDirection="ltr"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- القسم الأيسر: حلقة التارجت والأزرار السريعة -->
    <LinearLayout
        android:id="@+id/apple_section_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:orientation="vertical"
        android:gravity="center">

        <!-- حلقة التارجت الكهرمانية الذهبية مع مسار زجاجي دائم -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <ProgressBar
                android:id="@+id/pb_apple_ring"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/ring_progress_cyan" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_apple_orders_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_apple_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="#F59E0B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- نص الهدف اليومي -->
        <TextView
            android:id="@+id/tv_apple_target_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:text="طلب اليوم (الهدف 16)"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- أزرار التسجيل السريع الكهرمانية أسفل الحلقة -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_apple_increment"
                android:layout_width="50dp"
                android:layout_height="38dp"
                android:background="@drawable/btn_apple_plus"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="#1A1200"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_apple_decrement"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_apple_minus"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- فاصل زجاجي ناعم يطفو في المنتصف دون لمس الحواف -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="58dp"
        android:layout_gravity="center_vertical"
        android:background="#1AFFFFFF"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp" />

    <!-- القسم الأيمن: الوردية والدخل وطلبات الشهر (بتناغم واتزان كامل) -->
    <LinearLayout
        android:id="@+id/apple_section_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <!-- 1. شارة الوردية الزجاجية -->
        <TextView
            android:id="@+id/tv_apple_shift_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_apple_shift_pill"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="الوردية شغالة ●"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 2. دخل اليوم -->
        <TextView
            android:id="@+id/tv_apple_today_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:text="0.0 ر.س"
            android:textDirection="rtl"
            android:textColor="#22C55E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:text="دخل اليوم المتوقع"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <!-- 3. طلبات الشهر (بنفس الهيبة والتنسيق المتناسق) -->
        <TextView
            android:id="@+id/tv_apple_month_orders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:text="0 طلب"
            android:textDirection="rtl"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:text="طلبات الشهر"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
