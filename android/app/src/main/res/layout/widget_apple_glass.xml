<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apple_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_apple_glass_container"
    android:orientation="horizontal"
    android:layoutDirection="ltr"
    android:padding="10dp"
    android:gravity="center_vertical">

    <!-- القسم الأيسر: العداد وحلقة التارجت والأزرار -->
    <LinearLayout
        android:id="@+id/apple_section_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:orientation="vertical"
        android:gravity="center">

        <!-- حلقة التارجت النيون -->
        <FrameLayout
            android:layout_width="66dp"
            android:layout_height="66dp">

            <ProgressBar
                android:id="@+id/pb_apple_ring"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="37"
                android:progressDrawable="@drawable/ring_progress_cyan" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_apple_orders_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_apple_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- نص طلب اليوم والهدف -->
        <TextView
            android:id="@+id/tv_apple_target_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:text="طلب اليوم (الهدف 16)"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- أزرار التسجيل السريع -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_apple_increment"
                android:layout_width="52dp"
                android:layout_height="42dp"
                android:background="@drawable/btn_apple_plus"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_apple_decrement"
                android:layout_width="44dp"
                android:layout_height="42dp"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_apple_minus"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- خط فاصل ناعم بالمنتصف -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#1AFFFFFF"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp" />

    <!-- القسم الأيمن: الوردية والدخل وطلبات الشهر وصافي التوفير -->
    <LinearLayout
        android:id="@+id/apple_section_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.05"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="2dp">

        <!-- شارة الوردية الزجاجية -->
        <TextView
            android:id="@+id/tv_apple_shift_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_apple_shift_pill"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="الوردية شغالة ●"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- دخل اليوم -->
        <TextView
            android:id="@+id/tv_apple_today_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="دخل اليوم: 0.0 ر.س"
            android:textColor="#22C55E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- خط فاصل أفقي رفيع -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#14FFFFFF"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp" />

        <!-- طلبات الشهر -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طلبات الشهر: "
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_apple_month_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- صافي التوفير -->
        <TextView
            android:id="@+id/tv_apple_total_savings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="صافي التوفير: +0 ر.س"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
