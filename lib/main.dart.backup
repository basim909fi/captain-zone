  Future<void> openAddPastDayDialog({
    DailyRecord? editingRecord,
  }) async {
    DateTime pickedDate =
        editingRecord?.date ?? dateOnly(DateTime.now());

    bool isWorkDay = editingRecord?.isWorkDay ?? true;

    final ordersController = TextEditingController(
      text: editingRecord == null
          ? ''
          : editingRecord.ordersCount.toString(),
    );

    final today = dateOnly(DateTime.now());

    final result = await showDialog<DailyRecord>(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final isToday = isSameDay(pickedDate, today);

            return AlertDialog(
              backgroundColor: palette.dialogBg,
              title: Text(
                editingRecord == null
                    ? 'إضافة يوم سابق'
                    : 'تعديل اليوم',
                style: TextStyle(color: palette.textPrimary),
              ),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    OutlinedButton(
                      onPressed: () async {
                        final result = await _pickDate(
                          initialDate: pickedDate,
                          lastDate: today,
                        );

                        if (result != null) {
                          setDialogState(() {
                            pickedDate = dateOnly(result);
                          });
                        }
                      },
                      child: Text(
                        DateFormat('yyyy-MM-dd').format(pickedDate),
                        style: TextStyle(color: palette.textPrimary),
                      ),
                    ),
                    RadioListTile<bool>(
                      value: true,
                      groupValue: isWorkDay,
                      activeColor: palette.gold,
                      title: Text(
                        'يوم عمل',
                        style: TextStyle(color: palette.textPrimary),
                      ),
                      onChanged: (value) {
                        if (value == null) return;
                        setDialogState(() => isWorkDay = value);
                      },
                    ),
                    RadioListTile<bool>(
                      value: false,
                      groupValue: isWorkDay,
                      activeColor: palette.gold,
                      title: Text(
                        'إجازة',
                        style: TextStyle(color: palette.textPrimary),
                      ),
                      onChanged: (value) {
                        if (value == null) return;
                        setDialogState(() => isWorkDay = value);
                      },
                    ),
                    if (isWorkDay)
                      TextField(
                        controller: ordersController,
                        keyboardType: TextInputType.number,
                        style: TextStyle(color: palette.textPrimary),
                        decoration: glassInputDecoration(
                          palette,
                          'عدد الطلبات',
                        ),
                      ),
                    if (isToday)
                      Padding(
                        padding: const EdgeInsets.only(top: 12),
                        child: Text(
                          editingRecord != null
                              ? 'أنت تعدل سجل اليوم الحالي.'
                              : shiftOpen
                                  ? 'توجد وردية مفتوحة. أضف الطلبات من شاشة الوردية.'
                                  : 'لم تبدأ وردية اليوم بعد.',
                          textAlign: TextAlign.center,
                          style: const TextStyle(
                            color: AppColors.danger,
                            fontSize: 12,
                          ),
                        ),
                      ),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(dialogContext),
                  child: const Text('إلغاء'),
                ),
                ElevatedButton(
                  onPressed: () {
                    if (isToday && editingRecord == null) {
                      _showSnackBar(
                        shiftOpen
                            ? 'أضف الطلبات من شاشة الوردية الحالية'
                            : 'ابدأ وردية اليوم أولًا',
                      );
                      return;
                    }

                    int orders = 0;

                    if (isWorkDay) {
                      final parsed = int.tryParse(
                        ordersController.text.trim(),
                      );

                      if (parsed == null || parsed < 0) {
                        _showSnackBar('أدخل عدد طلبات صحيح');
                        return;
                      }

                      orders = parsed;
                    }

                    Navigator.pop(
                      dialogContext,
                      DailyRecord(
                        date: dateOnly(pickedDate),
                        isWorkDay: isWorkDay,
                        ordersCount: orders,
                        orderPrice: editingRecord?.orderPrice ??
                            SettingsData.orderPrice,
                      ),
                    );
                  },
                  child: const Text('حفظ'),
                ),
              ],
            );
          },
        );
      },
    );

    if (result == null) return;

    final existing = _recordForDate(result.date);

    if (existing != null && existing != editingRecord) {
      final confirmed = await _confirmDialog(
        title: 'استبدال سجل موجود',
        message: 'يوجد سجل لهذا التاريخ. هل تريد استبداله؟',
        confirmText: 'استبدال',
      );

      if (!confirmed) return;
    }

    setState(() => _upsertRecord(result));
    await _saveRecords();

    _showSnackBar(
      editingRecord == null ? 'تمت إضافة اليوم' : 'تم تعديل اليوم',
    );
  }

  // ============================================================
  // إضافة الأيام بالجملة
  // ============================================================

  Future<void> openBulkAddDaysDialog() async {
    DateTime startDate = dateOnly(DateTime.now());
    final controller = TextEditingController();

    final accepted = await showDialog<bool>(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final lines = controller.text
                .split('\n')
                .map((line) => line.trim())
                .where((line) => line.isNotEmpty)
                .toList();

            int futureCount = 0;
            int invalidCount = 0;

            for (int i = 0; i < lines.length; i++) {
              final currentDate = dateOnly(
                startDate.add(Duration(days: i)),
              );

              if (_isFutureDate(currentDate)) {
                futureCount++;
                continue;
              }

              final value = lines[i].toLowerCase();
              final holiday =
                  value == 'إجازة' || value == 'اجازة';

              if (!holiday) {
                final orders = int.tryParse(value);
                if (orders == null || orders < 0) {
                  invalidCount++;
                }
              }
            }

            return AlertDialog(
              backgroundColor: palette.dialogBg,
              title: Text(
                'إضافة أيام بالجملة',
                style: TextStyle(
                  color: palette.textPrimary,
                  fontWeight: FontWeight.bold,
                ),
              ),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    OutlinedButton(
                      onPressed: () async {
                        final result = await _pickDate(
                          initialDate: startDate,
                        );

                        if (result != null) {
                          setDialogState(() {
                            startDate = dateOnly(result);
                          });
                        }
                      },
                      child: Text(
                        DateFormat('yyyy-MM-dd').format(startDate),
                        style: TextStyle(color: palette.textPrimary),
                      ),
                    ),
                    const SizedBox(height: 12),
                    Text(
                      'اكتب عدد الطلبات في كل سطر، أو اكتب إجازة:',
                      style: TextStyle(
                        color: palette.textSecondary,
                        fontSize: 13,
                      ),
                    ),
                    const SizedBox(height: 8),
                    TextField(
                      controller: controller,
                      maxLines: 8,
                      onChanged: (_) => setDialogState(() {}),
                      style: TextStyle(color: palette.textPrimary),
                      decoration: glassInputDecoration(
                        palette,
                        'مثال:\n10\n8\nإجازة\n12',
                      ),
                    ),
                    if (futureCount > 0 || invalidCount > 0)
                      Padding(
                        padding: const EdgeInsets.only(top: 10),
                        child: Text(
                          [
                            if (futureCount > 0)
                              'سيتم تجاهل $futureCount يوم مستقبلي',
                            if (invalidCount > 0)
                              'سيتم تجاهل $invalidCount سطر غير صحيح',
                          ].join('\n'),
                          textAlign: TextAlign.center,
                          style: const TextStyle(
                            color: AppColors.danger,
                            fontSize: 12,
                          ),
                        ),
                      ),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(dialogContext, false),
                  child: const Text('إلغاء'),
                ),
                ElevatedButton(
                  onPressed: () => Navigator.pop(dialogContext, true),
                  child: const Text('معالجة'),
                ),
              ],
            );
          },
        );
      },
    );

    if (accepted != true) return;

    final lines = controller.text
        .split('\n')
        .map((line) => line.trim())
        .where((line) => line.isNotEmpty)
        .toList();

    if (lines.isEmpty) {
      _showSnackBar('اكتب البيانات أولًا');
      return;
    }

    final today = dateOnly(DateTime.now());
    final newRecords = <DailyRecord>[];

    int skipped = 0;
    int replaced = 0;

    for (int i = 0; i < lines.length; i++) {
      final currentDate = dateOnly(
        startDate.add(Duration(days: i)),
      );

      if (_isFutureDate(currentDate) ||
          isSameDay(currentDate, today)) {
        skipped++;
        continue;
      }

      final value = lines[i].toLowerCase();
      final holiday =
          value == 'إجازة' || value == 'اجازة';

      DailyRecord? record;

      if (holiday) {
        record = DailyRecord(
          date: currentDate,
          isWorkDay: false,
          ordersCount: 0,
          orderPrice: SettingsData.orderPrice,
        );
      } else {
        final orders = int.tryParse(value);

        if (orders == null || orders < 0) {
          skipped++;
          continue;
        }

        record = DailyRecord(
          date: currentDate,
          isWorkDay: true,
          ordersCount: orders,
          orderPrice: SettingsData.orderPrice,
        );
      }

      if (_recordForDate(currentDate) != null) {
        replaced++;
      }

      newRecords.add(record);
    }

    if (newRecords.isEmpty) {
      _showSnackBar('لم تتم إضافة أي سجل');
      return;
    }

    if (replaced > 0) {
      final confirmed = await _confirmDialog(
        title: 'استبدال سجلات موجودة',
        message:
            'يوجد $replaced سجل مسجل مسبقًا. هل تريد استبدالها؟',
        confirmText: 'استبدال',
      );

      if (!confirmed) return;
    }

    setState(() {
      for (final record in newRecords) {
        _upsertRecord(record);
      }
    });

    await _saveRecords();

    _showSnackBar(
      'تمت إضافة ${newRecords.length} يوم، وتجاوز $skipped سطر',
    );
  }

  // ============================================================
  // قائمة التعديل والحذف
  // ============================================================

  Future<String?> _actionsMenu(String title) {
    return showModalBottomSheet<String>(
      context: context,
      backgroundColor: palette.dialogBg,
      builder: (sheetContext) {
        return SafeArea(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Padding(
                padding: const EdgeInsets.all(16),
                child: Text(
                  title,
                  style: TextStyle(
                    color: palette.textPrimary,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
              ListTile(
                leading: Icon(Icons.edit, color: palette.gold),
                title: Text(
                  'تعديل',
                  style: TextStyle(color: palette.textPrimary),
                ),
                onTap: () => Navigator.pop(sheetContext, 'edit'),
              ),
              ListTile(
                leading: const Icon(
                  Icons.delete,
                  color: AppColors.danger,
                ),
                title: Text(
                  'حذف',
                  style: TextStyle(color: palette.textPrimary),
                ),
                onTap: () => Navigator.pop(sheetContext, 'delete'),
              ),
            ],
          ),
        );
      },
    );
  }

  Future<void> _recordActions(DailyRecord record) async {
    final action = await _actionsMenu(
      'سجل ${DateFormat('yyyy-MM-dd').format(record.date)}',
    );

    if (action == 'edit') {
      await openAddPastDayDialog(editingRecord: record);
    } else if (action == 'delete') {
      final confirmed = await _confirmDialog(
        title: 'حذف السجل',
        message: 'هل تريد حذف سجل هذا اليوم؟',
        confirmText: 'حذف',
      );

      if (!confirmed) return;

      setState(() => records.remove(record));
      await _saveRecords();
      _showSnackBar('تم حذف السجل');
    }
  }

  Future<void> _gasActions(GasEntry entry) async {
    final action = await _actionsMenu(
      'بنزين ${DateFormat('yyyy-MM-dd').format(entry.date)}',
    );

    if (action == 'edit') {
      await openAddGasDialog(editingEntry: entry);
    } else if (action == 'delete') {
      final confirmed = await _confirmDialog(
        title: 'حذف البنزين',
        message: 'هل تريد حذف عملية البنزين؟',
        confirmText: 'حذف',
      );

      if (!confirmed) return;

      setState(() => gasEntries.remove(entry));
      await _saveGasEntries();
      _showSnackBar('تم حذف عملية البنزين');
    }
  }

  Future<void> _expenseActions(OtherExpense expense) async {
    final action = await _actionsMenu(
      'مصروف ${DateFormat('yyyy-MM-dd').format(expense.date)}',
    );

    if (action == 'edit') {
      await openAddOtherExpenseDialog(
        editingExpense: expense,
      );
    } else if (action == 'delete') {
      final confirmed = await _confirmDialog(
        title: 'حذف المصروف',
        message: 'هل تريد حذف المصروف؟',
        confirmText: 'حذف',
      );

      if (!confirmed) return;

      setState(() => otherExpenses.remove(expense));
      await _saveOtherExpenses();
      _showSnackBar('تم حذف المصروف');
    }
  }

  // ============================================================
  // النسخة الاحتياطية والاستعادة
  // ============================================================

  Map<String, dynamic> _backupData() {
    return {
      'version': 3,
      'exportedAt': DateTime.now().toIso8601String(),
      'records': records.map((record) => record.toJson()).toList(),
      'monthlyRents':
          monthlyRents.map((rent) => rent.toJson()).toList(),
      'gasEntries':
          gasEntries.map((entry) => entry.toJson()).toList(),
      'otherExpenses':
          otherExpenses.map((expense) => expense.toJson()).toList(),
      'settings': {
        'orderPrice': SettingsData.orderPrice,
        'monthlyRent': SettingsData.monthlyRent,
        'dailyTarget': SettingsData.dailyTarget,
        'monthlyGoal': SettingsData.monthlyGoal,
      },
      'activeShift': shiftOpen && shiftStartDate != null
          ? {
              'shiftStartDate':
                  shiftStartDate!.toIso8601String(),
              'ordersCount': todayOrders,
              'orderPrice': activeOrderPrice,
            }
          : null,
    };
  }

  Future<void> _exportBackup() async {
    final text = jsonEncode(_backupData());

    await Clipboard.setData(
      ClipboardData(text: text),
    );

    _showSnackBar(
      'تم نسخ النسخة الاحتياطية إلى الحافظة ✅',
    );
  }

  Future<bool> _importBackup(String text) async {
    try {
      final decoded = jsonDecode(text);

      if (decoded is! Map) {
        return false;
      }

      final data = Map<String, dynamic>.from(decoded);

      if (data['records'] is! List ||
          data['gasEntries'] is! List) {
        return false;
      }

      final importedRecords =
          (data['records'] as List).map((item) {
        return DailyRecord.fromJson(
          Map<String, dynamic>.from(item),
        );
      }).toList();

      final importedGasEntries =
          (data['gasEntries'] as List).map((item) {
        return GasEntry.fromJson(
          Map<String, dynamic>.from(item),
        );
      }).toList();

      final importedOtherExpenses =
          (data['otherExpenses'] as List? ?? []).map((item) {
        return OtherExpense.fromJson(
          Map<String, dynamic>.from(item),
        );
      }).toList();

      final importedRents =
          (data['monthlyRents'] as List? ?? []).map((item) {
        return MonthlyRentEntry.fromJson(
          Map<String, dynamic>.from(item),
        );
      }).toList();

      final settingsRaw = data['settings'];

      if (settingsRaw is! Map) {
        return false;
      }

      final settings =
          Map<String, dynamic>.from(settingsRaw);

      final importedOrderPrice =
          (settings['orderPrice'] as num?)?.toDouble();

      final importedMonthlyRent =
          (settings['monthlyRent'] as num?)?.toDouble() ??
          SettingsData.monthlyRent;

      final importedDailyTarget =
          (settings['dailyTarget'] as num?)?.toInt();

      final importedMonthlyGoal =
          (settings['monthlyGoal'] as num?)?.toInt();

      if (importedOrderPrice == null ||
          importedDailyTarget == null ||
          importedMonthlyGoal == null) {
        return false;
      }

      final confirmed = await _confirmDialog(
        title: 'تأكيد الاستعادة',
        message:
            'سيتم استبدال جميع البيانات الحالية بالنسخة الاحتياطية. '
            'هل تريد المتابعة؟',
        confirmText: 'استعادة',
      );

      if (!confirmed) {
        return false;
      }

      setState(() {
        records
          ..clear()
          ..addAll(importedRecords);

        gasEntries
          ..clear()
          ..addAll(importedGasEntries);

        otherExpenses
          ..clear()
          ..addAll(importedOtherExpenses);

        monthlyRents
          ..clear()
          ..addAll(importedRents);

        SettingsData.orderPrice =
            importedOrderPrice;

        SettingsData.monthlyRent =
            importedMonthlyRent;

        SettingsData.dailyTarget =
            importedDailyTarget;

        SettingsData.monthlyGoal =
            importedMonthlyGoal;

        shiftOpen = false;
        shiftStartDate = null;
        todayOrders = 0;
        activeOrderPrice = SettingsData.orderPrice;

        final activeRaw = data['activeShift'];

        if (activeRaw is Map) {
          final active =
              Map<String, dynamic>.from(activeRaw);

          final start = active['shiftStartDate'];

          if (start != null) {
            shiftOpen = true;
            shiftStartDate =
                DateTime.parse(start.toString());

            todayOrders =
                (active['ordersCount'] as num?)?.toInt() ?? 0;

            activeOrderPrice =
                (active['orderPrice'] as num?)?.toDouble() ??
                    SettingsData.orderPrice;
          }
        }
      });

      await _saveAllData();

      if (shiftOpen) {
        await _saveActiveShift();
      } else {
        await _clearActiveShift();
      }

      _showSnackBar(
        'تمت استعادة النسخة الاحتياطية بنجاح ✅',
      );

      return true;
    } catch (_) {
      return false;
    }
  }

