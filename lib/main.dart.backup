  Future<void> openSettingsDialog() async {
    final priceController = TextEditingController(
      text: SettingsData.orderPrice.toString(),
    );

    final rentController = TextEditingController(
      text: SettingsData.monthlyRent.toString(),
    );

    final targetController = TextEditingController(
      text: SettingsData.dailyTarget.toString(),
    );

    final goalController = TextEditingController(
      text: SettingsData.monthlyGoal.toString(),
    );

    final result = await showDialog<Map<String, dynamic>>(
      context: context,
      builder: (dialogContext) {
        return AlertDialog(
          backgroundColor: palette.dialogBg,
          title: Text(
            'الإعدادات',
            style: TextStyle(color: palette.textPrimary),
          ),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(
                  controller: priceController,
                  keyboardType:
                      const TextInputType.numberWithOptions(
                    decimal: true,
                  ),
                  style: TextStyle(color: palette.textPrimary),
                  decoration: glassInputDecoration(
                    palette,
                    'سعر الطلب الواحد',
                  ),
                ),
                const SizedBox(height: 10),
                TextField(
                  controller: rentController,
                  keyboardType:
                      const TextInputType.numberWithOptions(
                    decimal: true,
                  ),
                  style: TextStyle(color: palette.textPrimary),
                  decoration: glassInputDecoration(
                    palette,
                    'إيجار السيارة الشهري',
                  ),
                ),
                const SizedBox(height: 10),
                TextField(
                  controller: targetController,
                  keyboardType: TextInputType.number,
                  style: TextStyle(color: palette.textPrimary),
                  decoration: glassInputDecoration(
                    palette,
                    'التارجت اليومي',
                  ),
                ),
                const SizedBox(height: 10),
                TextField(
                  controller: goalController,
                  keyboardType: TextInputType.number,
                  style: TextStyle(color: palette.textPrimary),
                  decoration: glassInputDecoration(
                    palette,
                    'هدف الطلبات الشهري - 0 بدون هدف',
                  ),
                ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(dialogContext),
              child: const Text('إلغاء'),
            ),
            ElevatedButton(
              onPressed: () {
                final orderPrice = double.tryParse(
                  priceController.text.trim(),
                );
                final monthlyRent = double.tryParse(
                  rentController.text.trim(),
                );
                final dailyTarget = int.tryParse(
                  targetController.text.trim(),
                );
                final monthlyGoal = int.tryParse(
                  goalController.text.trim(),
                );

                if (orderPrice == null ||
                    orderPrice < 0 ||
                    monthlyRent == null ||
                    monthlyRent < 0 ||
                    dailyTarget == null ||
                    dailyTarget < 0 ||
                    monthlyGoal == null ||
                    monthlyGoal < 0) {
                  _showSnackBar(
                    'تأكد من إدخال أرقام صحيحة وغير سالبة',
                  );
                  return;
                }

                Navigator.pop(
                  dialogContext,
                  {
                    'orderPrice': orderPrice,
                    'monthlyRent': monthlyRent,
                    'dailyTarget': dailyTarget,
                    'monthlyGoal': monthlyGoal,
                  },
                );
              },
              child: const Text('متابعة'),
            ),
          ],
        );
      },
    );

    if (result == null) return;

    final newOrderPrice = result['orderPrice'] as double;
    final newMonthlyRent = result['monthlyRent'] as double;
    final newDailyTarget = result['dailyTarget'] as int;
    final newMonthlyGoal = result['monthlyGoal'] as int;

    final priceChanged =
        newOrderPrice != SettingsData.orderPrice;

    final rentChanged =
        newMonthlyRent != SettingsData.monthlyRent;

    if (priceChanged || rentChanged) {
      final confirmed = await _confirmDialog(
        title: 'تنبيه تغيير الأسعار',
        message:
            'سعر الطلب الجديد سيطبق على الأيام والورديات الجديدة فقط، '
            'وستبقى الأسعار القديمة كما هي.\n\n'
            'الإيجار الجديد سيطبق على الأشهر الجديدة فقط، '
            'أما الأشهر التي لها إيجار محفوظ فلن تتغير.\n\n'
            'هل تريد المتابعة؟',
        confirmText: 'تغيير الأسعار',
      );

      if (!confirmed) return;
    }

    setState(() {
      SettingsData.orderPrice = newOrderPrice;
      SettingsData.monthlyRent = newMonthlyRent;
      SettingsData.dailyTarget = newDailyTarget;
      SettingsData.monthlyGoal = newMonthlyGoal;
    });

    await SettingsData.save();

    _showSnackBar('تم حفظ الإعدادات');
  }

  // ============================================================
  // إيجار شهر محدد
