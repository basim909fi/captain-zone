  Future<void> openAddGasDialog({
    GasEntry? editingEntry,
  }) async {
    DateTime pickedDate =
        editingEntry?.date ?? DateTime.now();

    bool isCompany =
        editingEntry?.isCompany ?? true;

    final amountController = TextEditingController(
      text: editingEntry == null
          ? ''
          : editingEntry.amount.toString(),
    );

    final result = await showDialog<GasEntry>(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              backgroundColor: palette.dialogBg,
              title: Text(
                editingEntry == null
                    ? 'إضافة بنزين'
                    : 'تعديل البنزين',
                style: TextStyle(
                  color: palette.textPrimary,
                ),
              ),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    OutlinedButton(
                      onPressed: () async {
                        final result = await _pickDate(
                          initialDate: pickedDate,
                        );

                        if (result != null) {
                          setDialogState(() {
                            pickedDate = dateOnly(result);
                          });
                        }
                      },
                      child: Text(
                        DateFormat('yyyy-MM-dd')
                            .format(pickedDate),
                        style: TextStyle(
                          color: palette.textPrimary,
                        ),
                      ),
                    ),
                    RadioListTile<bool>(
                      value: true,
                      groupValue: isCompany,
                      activeColor: palette.gold,
                      title: Text(
                        'بنزين الشركة',
                        style: TextStyle(
                          color: palette.textPrimary,
                        ),
                      ),
                      onChanged: (value) {
                        if (value == null) return;
                        setDialogState(() {
                          isCompany = value;
                        });
                      },
                    ),
                    RadioListTile<bool>(
                      value: false,
                      groupValue: isCompany,
                      activeColor: palette.gold,
                      title: Text(
                        'بنزين جيبي',
                        style: TextStyle(
                          color: palette.textPrimary,
                        ),
                      ),
                      onChanged: (value) {
                        if (value == null) return;
                        setDialogState(() {
                          isCompany = value;
                        });
                      },
                    ),
                    TextField(
                      controller: amountController,
                      keyboardType:
                          const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      style: TextStyle(
                        color: palette.textPrimary,
                      ),
                      decoration: glassInputDecoration(
                        palette,
                        'المبلغ - ر.س',
                      ),
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(dialogContext),
                  child: const Text('إلغاء'),
                ),
                ElevatedButton(
                  onPressed: () {
                    if (_isFutureDate(pickedDate)) {
                      _showSnackBar(
                        'لا يمكن تسجيل بنزين بتاريخ مستقبلي',
                      );
                      return;
                    }

                    final amount = double.tryParse(
                      amountController.text.trim(),
                    );

                    if (amount == null || amount <= 0) {
                      _showSnackBar('أدخل مبلغًا صحيحًا');
                      return;
                    }

                    Navigator.pop(
                      dialogContext,
                      GasEntry(
                        date: dateOnly(pickedDate),
                        amount: amount,
                        isCompany: isCompany,
                      ),
                    );
                  },
                  child: const Text('حفظ'),
                ),
              ],
            );
          },
        );
      },
    );

    if (result == null) return;

    setState(() {
      if (editingEntry == null) {
        gasEntries.add(result);
      } else {
        final index = gasEntries.indexOf(editingEntry);
        if (index >= 0) {
          gasEntries[index] = result;
        }
      }
    });

    await _saveGasEntries();

    _showSnackBar(
      editingEntry == null
          ? 'تمت إضافة البنزين'
          : 'تم تعديل البنزين',
    );
  }

