                  ),
                ),
                const SizedBox(height: 10),
                ElevatedButton.icon(
                  onPressed: () async {
                    final success = await _importBackup(
                      restoreController.text.trim(),
                    );

                    if (!success) {
                      _showSnackBar(
                        'النص غير صحيح أو لم تتم الاستعادة',
                      );
                    }

                    if (dialogContext.mounted) {
                      Navigator.pop(dialogContext);
                    }
                  },
                  icon: const Icon(Icons.restore),
                  label: const Text(
                    'استعادة النسخة',
                  ),
                ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(dialogContext),
              child: const Text('إغلاق'),
            ),
          ],
        );
      },
    );
  }

  // ============================================================
  // التوقعات
  // ============================================================

  String _smartProjection() {
    final now = DateTime.now();

    final isCurrentMonth =
        selectedMonth == now.month &&
        selectedYear == now.year;

    if (!isCurrentMonth || monthlyOrders <= 0) {
      return '';
    }

    final daysPassed = now.day;
    final daysInMonth = DateTime(
      selectedYear,
      selectedMonth + 1,
      0,
    ).day;

    final remainingDays = daysInMonth - daysPassed;
    final averageOrders = monthlyOrders / daysPassed;
    final projectedOrders =
        (averageOrders * daysInMonth).round();

    final projectedGross =
        projectedOrders * SettingsData.orderPrice;

    final projectedGas =
        (monthlyCompanyGas + monthlyPersonalGas) *
            daysInMonth /
            daysPassed;

    final projectedOther =
        monthlyOtherExpenses *
            daysInMonth /
            daysPassed;

    final projectedNet = projectedGross -
        monthlyRent -
        projectedGas -
        projectedOther;

    String text =
        'بمعدلك الحالي ${averageOrders.toStringAsFixed(1)} '
        'طلب/يوم، التوقع التقريبي هو $projectedOrders طلب '
        'وصافي تقريبي ${projectedNet.toStringAsFixed(0)} ر.س '
        'بنهاية الشهر.';

    if (SettingsData.monthlyGoal > 0) {
      final remaining =
          SettingsData.monthlyGoal - monthlyOrders;

      if (remaining > 0 && remainingDays > 0) {
        final needed = remaining / remainingDays;

        text +=
            '\n\n🎯 تحتاج $remaining طلب إضافي خلال '
            '$remainingDays يوم، أي '
            '${needed.toStringAsFixed(1)} طلب يوميًا.';
      } else if (remaining <= 0) {
        text += '\n\n🎉 مبروك! لقد تجاوزت هدف الشهر.';
      }
    }

    return text;
  }

  // ============================================================
  // توليد التقرير والمشاركة
  // ============================================================

  Future<Uint8List> _generateReportBytes() async {
    int previousMonth = selectedMonth - 1;
    int previousYear = selectedYear;

    if (previousMonth < 1) {
      previousMonth = 12;
      previousYear--;
    }

    final current = _statsFor(
      selectedYear,
      selectedMonth,
    );

    final previous = _statsFor(
      previousYear,
      previousMonth,
    );

    final daily = _dailyGrossSeries(
      selectedYear,
      selectedMonth,
    );

    final daysInMonth = DateTime(
      selectedYear,
      selectedMonth + 1,
      0,
    ).day;

    final recorder = ui.PictureRecorder();
    final canvas = Canvas(recorder);

    const size = Size(1080, 2050);
    const exportScale = 2.5;

    final painter = _ReportPainter(
      monthName: monthNames[selectedMonth],
      previousMonthName: monthNames[previousMonth],
      year: selectedYear,
      current: current,
      previous: previous,
      dailySeries: daily,
      daysInMonth: daysInMonth,
      isDark: isDarkMode,
      logoImage: logoImage,
    );

    canvas.scale(exportScale);
    painter.paint(canvas, size);

    final picture = recorder.endRecording();

    final image = await picture.toImage(
      (size.width * exportScale).toInt(),
      (size.height * exportScale).toInt(),
    );

    final byteData = await image.toByteData(
      format: ui.ImageByteFormat.png,
    );

    if (byteData == null) {
      throw Exception('تعذر إنشاء صورة التقرير');
    }

    return byteData.buffer.asUint8List();
  }

  Future<void> shareMonthlyReport() async {
    if (isGeneratingReport) return;

    setState(() {
      isGeneratingReport = true;
    });

    try {
      final bytes = await _generateReportBytes();

      await Share.shareXFiles(
        [
          XFile.fromData(
            bytes,
            name:
                'monthly_report_${selectedYear}_${selectedMonth}.png',
            mimeType: 'image/png',
          ),
        ],
        subject:
            'تقرير شهر ${monthNames[selectedMonth]} $selectedYear',
      );
    } catch (_) {
      _showSnackBar('حدث خطأ أثناء إنشاء التقرير');
    } finally {
      if (mounted) {
        setState(() {
          isGeneratingReport = false;
        });
      }
    }
  }

  Future<void> saveReportToGallery() async {
    await shareMonthlyReport();
  }

  // ============================================================
  // بناء الواجهة الرئيسية
  // ============================================================

  @override
  Widget build(BuildContext context) {
    final p = palette;

    if (isLoading) {
      return Scaffold(
        backgroundColor: p.bgGradient.first,
        body: Center(
          child: CircularProgressIndicator(color: p.gold),
        ),
      );
    }

    final tabs = [
      _TodayTab(
        palette: p,
        shiftOpen: shiftOpen,
        todayOrders: todayOrders,
        shiftStartDate: shiftStartDate,
        onIncrement: incrementOrders,
        onDecrement: decrementOrders,
        onStart: startNewShift,
        onFinish: finishWorkDay,
        onHoliday: markHoliday,
        onEditDate: editShiftDate,
      ),
      _StatsTab(
        palette: p,
        selectedMonth: selectedMonth,
        selectedYear: selectedYear,
        monthNames: monthNames,
        monthlyOrders: monthlyOrders,
        monthlyGross: monthlyGross,
        monthlyRent: monthlyRent,
        monthlyCompanyGas: monthlyCompanyGas,
        monthlyPersonalGas: monthlyPersonalGas,
        monthlyOtherExpenses: monthlyOtherExpenses,
        monthlyNet: monthlyNet,
        previousMonthNet: previousMonthNet,
        hasPreviousMonthData: hasPreviousMonthData,
        projection: _smartProjection(),
        onMonthChanged: changeMonth,
        onYearShift: changeYear,
        onEditRent: editSelectedMonthRent,
        onShareReport: shareMonthlyReport,
        onSaveReport: saveReportToGallery,
      ),
      _HistoryTab(
        palette: p,
        records: filteredRecords,
        gasEntries: filteredGasEntries,
        otherExpenses: filteredOtherExpenses,
        onAddPastDay: () => openAddPastDayDialog(),
        onAddBulkDays: openBulkAddDaysDialog,
        onRecordLongPress: _recordActions,
        onGasLongPress: _gasActions,
        onOtherLongPress: _expenseActions,
      ),
    ];

    return Directionality(
      textDirection: ui.TextDirection.rtl,
      child: Scaffold(
        appBar: AppBar(
          backgroundColor: p.appBarBg,
          title: Text(
            'كشف الطلبات',
            style: TextStyle(color: p.textPrimary),
          ),
          iconTheme: IconThemeData(color: p.textPrimary),
          actions: [
            IconButton(
              tooltip: 'تبديل الوضع',
              icon: Icon(
                isDarkMode
                    ? Icons.light_mode
                    : Icons.dark_mode,
              ),
              onPressed: toggleDarkMode,
            ),
            PopupMenuButton<String>(
              color: p.dialogBg,
              icon: Icon(
                Icons.more_vert,
                color: p.textPrimary,
              ),
              onSelected: (value) {
                switch (value) {
                  case 'gas':
                    openAddGasDialog();
                    break;
                  case 'expense':
                    openAddOtherExpenseDialog();
                    break;
                  case 'backup':
                    openBackupDialog();
                    break;
                  case 'settings':
                    openSettingsDialog();
                    break;
                }
              },
              itemBuilder: (_) => [
                PopupMenuItem(
                  value: 'gas',
                  child: Text(
                    'إضافة بنزين',
                    style: TextStyle(color: p.textPrimary),
                  ),
                ),
                PopupMenuItem(
                  value: 'expense',
                  child: Text(
                    'إضافة مصروف آخر',
                    style: TextStyle(color: p.textPrimary),
                  ),
                ),
                PopupMenuItem(
                  value: 'backup',
                  child: Text(
                    'نسخة احتياطية',
                    style: TextStyle(color: p.textPrimary),
                  ),
                ),
                PopupMenuItem(
                  value: 'settings',
                  child: Text(
                    'الإعدادات',
                    style: TextStyle(color: p.textPrimary),
                  ),
                ),
              ],
            ),
          ],
        ),
        body: Container(
          decoration: BoxDecoration(
            gradient: LinearGradient(
              begin: Alignment.topCenter,
              end: Alignment.bottomCenter,
              colors: p.bgGradient,
            ),
          ),
          child: SafeArea(
            child: IndexedStack(
              index: currentTab,
              children: tabs,
            ),
          ),
        ),
        bottomNavigationBar: NavigationBar(
          backgroundColor: p.navBg,
          selectedIndex: currentTab,
          onDestinationSelected: (value) {
            setState(() {
              currentTab = value;
            });
          },
          indicatorColor: p.gold.withOpacity(.25),
          destinations: [
            NavigationDestination(
              icon: Icon(
                Icons.today_outlined,
                color: p.textSecondary,
              ),
              selectedIcon: Icon(
                Icons.today,
                color: p.gold,
              ),
              label: 'اليوم',
            ),
            NavigationDestination(
              icon: Icon(
                Icons.bar_chart_outlined,
                color: p.textSecondary,
              ),
              selectedIcon: Icon(
                Icons.bar_chart,
                color: p.gold,
              ),
              label: 'الإحصائيات',
            ),
            NavigationDestination(
              icon: Icon(
                Icons.history_outlined,
                color: p.textSecondary,
              ),
              selectedIcon: Icon(
                Icons.history,
                color: p.gold,
              ),
              label: 'السجل',
            ),
          ],
        ),
      ),
    );
  }
}

// ============================================================
// تبويب اليوم
// ============================================================

class _TodayTab extends StatelessWidget {
  final Palette palette;
  final bool shiftOpen;
  final int todayOrders;
  final DateTime? shiftStartDate;
  final VoidCallback onIncrement;
  final VoidCallback onDecrement;
  final VoidCallback onStart;
  final VoidCallback onFinish;
  final VoidCallback onHoliday;
  final VoidCallback onEditDate;

  const _TodayTab({
    required this.palette,
    required this.shiftOpen,
    required this.todayOrders,
    required this.shiftStartDate,
    required this.onIncrement,
    required this.onDecrement,
    required this.onStart,
    required this.onFinish,
    required this.onHoliday,
    required this.onEditDate,
  });

  @override
  Widget build(BuildContext context) {
    final p = palette;

    final target = SettingsData.dailyTarget;
    final double progress = target > 0
        ? (todayOrders / target)
            .clamp(0.0, 1.0)
            .toDouble()
        : 0.0;

    final displayDate = shiftOpen
        ? (shiftStartDate ?? DateTime.now())
        : DateTime.now();

    return SingleChildScrollView(
      padding: const EdgeInsets.fromLTRB(
        16,
        16,
        16,
        24,
      ),
      child: GlassCard(
        palette: p,
        child: Column(
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Text(
                  DateFormat('yyyy-MM-dd')
                      .format(displayDate),
                  style: TextStyle(
                    color: p.textSecondary,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                if (shiftOpen) ...[
                  const SizedBox(width: 6),
                  InkWell(
                    onTap: onEditDate,
                    child: Icon(
                      Icons.edit,
                      size: 16,
                      color: p.textMuted,
                    ),
                  ),
                ],
              ],
            ),
            const SizedBox(height: 10),
            Container(
              padding: const EdgeInsets.symmetric(
                horizontal: 14,
                vertical: 6,
              ),
              decoration: BoxDecoration(
                color: shiftOpen
                    ? AppColors.success.withOpacity(.16)
                    : p.textMuted.withOpacity(.14),
                borderRadius: BorderRadius.circular(20),
                border: Border.all(
                  color: shiftOpen
                      ? AppColors.success.withOpacity(.5)
                      : p.textMuted.withOpacity(.4),
                ),
              ),
              child: Text(
                shiftOpen
                    ? 'الوردية مفتوحة'
                    : 'لا توجد وردية مفتوحة',
                style: TextStyle(
                  color: shiftOpen
                      ? AppColors.success
                      : p.textMuted,
                  fontWeight: FontWeight.bold,
                  fontSize: 13,
                ),
              ),
            ),
            const SizedBox(height: 26),
            GestureDetector(
              onTap: onIncrement,
              onLongPress: onDecrement,
              child: SizedBox(
                width: 190,
                height: 190,
                child: Stack(
                  alignment: Alignment.center,
                  children: [
                    CircularProgressIndicator(
                      value: progress,
                      strokeWidth: 12,
                      backgroundColor: p.cardBorder,
                      valueColor:
                          AlwaysStoppedAnimation<Color>(p.gold),
                    ),
                    Column(
                      mainAxisAlignment:
                          MainAxisAlignment.center,
                      children: [
                        Text(
                          '$todayOrders',
                          style: TextStyle(
                            color: p.textPrimary,
                            fontSize: 48,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        Text(
                          'من $target طلب',
                          style: TextStyle(
                            color: p.textSecondary,
                            fontSize: 13,
                          ),
                        ),
                      ],
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 10),
            Text(
              'ضغط عادي للإضافة - ضغط مطول للإنقاص',
              style: TextStyle(
                color: p.textMuted,
                fontSize: 12,
              ),
            ),
            const SizedBox(height: 24),
            if (shiftOpen)
              SizedBox(
                width: double.infinity,
                height: 52,
                child: ElevatedButton(
                  onPressed: onFinish,
                  style: ElevatedButton.styleFrom(
                    backgroundColor: p.gold,
                    foregroundColor: p.isDark
                        ? const Color(0xFF0B1F3A)
                        : Colors.white,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(14),
                    ),
                  ),
                  child: const Text(
                    'حفظ وإنهاء الوردية',
                    style: TextStyle(
                      fontWeight: FontWeight.bold,
                      fontSize: 15,
                    ),
                  ),
                ),
              )
            else ...[
              SizedBox(
                width: double.infinity,
                height: 52,
                child: ElevatedButton(
                  onPressed: onStart,
                  style: ElevatedButton.styleFrom(
                    backgroundColor: p.gold,
                    foregroundColor: p.isDark
                        ? const Color(0xFF0B1F3A)
                        : Colors.white,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(14),
                    ),
                  ),
                  child: const Text(
                    'بدء وردية جديدة',
                    style: TextStyle(
                      fontWeight: FontWeight.bold,
                      fontSize: 15,
                    ),
                  ),
                ),
              ),
              const SizedBox(height: 10),
              SizedBox(
                width: double.infinity,
                height: 52,
                child: OutlinedButton(
                  onPressed: onHoliday,
                  style: OutlinedButton.styleFrom(
                    side: const BorderSide(
                      color: AppColors.danger,
                    ),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(14),
                    ),
                  ),
                  child: const Text(
                    'تسجيل اليوم كإجازة',
                    style: TextStyle(
                      color: AppColors.danger,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }
}

