import 'dart:convert';
import 'dart:typed_data';
import 'dart:ui' as ui;

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:intl/intl.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:share_plus/share_plus.dart';

void main() {
  runApp(const CaptainZoneApp());
}

// ============================================================
// أدوات عامة
// ============================================================

bool isSameDay(DateTime a, DateTime b) {
  return a.year == b.year &&
      a.month == b.month &&
      a.day == b.day;
}

DateTime dateOnly(DateTime value) {
  return DateTime(value.year, value.month, value.day);
}

String money(double value) {
  return '${value.toStringAsFixed(1)} ر.س';
}

// ============================================================
// الإعدادات
// ============================================================

class SettingsData {
  static double orderPrice = 10.0;
  static double monthlyRent = 0.0;
  static int dailyTarget = 16;
  static int monthlyGoal = 0;

  static Future<void> load() async {
    final prefs = await SharedPreferences.getInstance();

    orderPrice = prefs.getDouble('orderPrice') ?? orderPrice;

    monthlyRent =
        prefs.getDouble('monthlyRent') ??
        prefs.getDouble('dailyRent') ??
        monthlyRent;

    dailyTarget = prefs.getInt('dailyTarget') ?? dailyTarget;
    monthlyGoal = prefs.getInt('monthlyGoal') ?? monthlyGoal;
  }

  static Future<void> save() async {
    final prefs = await SharedPreferences.getInstance();

    await prefs.setDouble('orderPrice', orderPrice);
    await prefs.setDouble('monthlyRent', monthlyRent);
    await prefs.setInt('dailyTarget', dailyTarget);
    await prefs.setInt('monthlyGoal', monthlyGoal);
  }
}

// ============================================================
// سجل اليوم
// ============================================================

class DailyRecord {
  DateTime date;
  bool isWorkDay;
  int ordersCount;
  double orderPrice;

  DailyRecord({
    required this.date,
    required this.isWorkDay,
    this.ordersCount = 0,
    double? orderPrice,
  }) : orderPrice = orderPrice ?? SettingsData.orderPrice;

  double get grossIncome {
    return isWorkDay ? ordersCount * orderPrice : 0.0;
  }

  Map<String, dynamic> toJson() {
    return {
      'date': date.toIso8601String(),
      'isWorkDay': isWorkDay,
      'ordersCount': ordersCount,
      'orderPrice': orderPrice,
    };
  }

  factory DailyRecord.fromJson(Map<String, dynamic> json) {
    return DailyRecord(
      date: DateTime.parse(json['date'].toString()),
      isWorkDay: json['isWorkDay'] == true,
      ordersCount: (json['ordersCount'] as num?)?.toInt() ?? 0,
      orderPrice: (json['orderPrice'] as num?)?.toDouble(),
    );
  }
}

// ============================================================
// إيجار الشهر
// ============================================================

class MonthlyRentEntry {
  final int year;
  final int month;
  double amount;

  MonthlyRentEntry({
    required this.year,
    required this.month,
    required this.amount,
  });

  Map<String, dynamic> toJson() {
    return {
      'year': year,
      'month': month,
      'amount': amount,
    };
  }

  factory MonthlyRentEntry.fromJson(Map<String, dynamic> json) {
    return MonthlyRentEntry(
      year: (json['year'] as num).toInt(),
      month: (json['month'] as num).toInt(),
      amount: (json['amount'] as num).toDouble(),
    );
  }
}

// ============================================================
// البنزين
// ============================================================

class GasEntry {
  DateTime date;
  double amount;
  bool isCompany;

  GasEntry({
    required this.date,
    required this.amount,
    required this.isCompany,
  });

  Map<String, dynamic> toJson() {
    return {
      'date': date.toIso8601String(),
      'amount': amount,
      'isCompany': isCompany,
    };
  }

  factory GasEntry.fromJson(Map<String, dynamic> json) {
    return GasEntry(
      date: DateTime.parse(json['date'].toString()),
      amount: (json['amount'] as num).toDouble(),
      isCompany: json['isCompany'] == true,
    );
  }
}

// ============================================================
// المصاريف الأخرى
// ============================================================

class OtherExpense {
  DateTime date;
  double amount;
  String category;
  String description;

  OtherExpense({
    required this.date,
    required this.amount,
    required this.category,
    this.description = '',
  });

  String get categoryLabel {
    switch (category) {
      case 'traffic_fine':
        return 'مخالفة مرورية';
      case 'accident':
        return 'حادث';
      default:
        return 'أخرى';
    }
  }

  String get categoryIcon {
    switch (category) {
      case 'traffic_fine':
        return '🚔';
      case 'accident':
        return '🚗💥';
      default:
        return '📝';
    }
  }

  Map<String, dynamic> toJson() {
    return {
      'date': date.toIso8601String(),
      'amount': amount,
      'category': category,
      'description': description,
    };
  }

  factory OtherExpense.fromJson(Map<String, dynamic> json) {
    return OtherExpense(
      date: DateTime.parse(json['date'].toString()),
      amount: (json['amount'] as num).toDouble(),
      category: json['category']?.toString() ?? 'other',
      description: json['description']?.toString() ?? '',
    );
  }
}

// ============================================================
// إحصائيات الشهر
// ============================================================

class MonthStats {
  final int orders;
  final double gross;
  final double rent;
  final double companyGas;
  final double personalGas;
  final double otherExpenses;

  const MonthStats({
    required this.orders,
    required this.gross,
    required this.rent,
    required this.companyGas,
    required this.personalGas,
    required this.otherExpenses,
  });

  double get expenses {
    return rent +
        companyGas +
        personalGas +
        otherExpenses;
  }

  double get net {
    return gross - expenses;
  }
}

// ============================================================
// الألوان
// ============================================================

class AppColors {
  static const gold = Color(0xFFD4AF37);
  static const goldDark = Color(0xFFC9971F);
  static const success = Color(0xFF2FBE77);
  static const danger = Color(0xFFE0555F);
  static const otherExpense = Color(0xFF4A9BD9);
}

class Palette {
  final bool isDark;

  Palette(this.isDark);

  List<Color> get bgGradient {
    return isDark
        ? const [
            Color(0xFF0B1F3A),
            Color(0xFF0A1428),
          ]
        : const [
            Color(0xFFFFF8E8),
            Color(0xFFF0E4C8),
          ];
  }

  Color get navBg =>
      isDark ? const Color(0xFF0B1F3A) : const Color(0xFFFFF2D9);

  Color get appBarBg =>
      isDark ? const Color(0xFF0B1F3A) : const Color(0xFFFFF2D9);

  Color get dialogBg =>
      isDark ? const Color(0xFF16305A) : Colors.white;

  Color get textPrimary =>
      isDark ? Colors.white : const Color(0xFF241905);

  Color get textSecondary =>
      isDark ? Colors.white70 : const Color(0xFF6B5A34);

  Color get textMuted =>
      isDark ? Colors.white54 : const Color(0xFF9C8A5E);

  Color get gold =>
      isDark ? AppColors.gold : AppColors.goldDark;

  Color get cardBorder =>
      isDark ? Colors.white.withOpacity(.14) : const Color(0xFFE9D9AE);

  Color get inputFill =>
      isDark ? Colors.white.withOpacity(.08) : const Color(0xFFF4E9CC);
}

class GlassCard extends StatelessWidget {
  final Widget child;
  final Palette palette;
  final EdgeInsetsGeometry padding;

  const GlassCard({
    super.key,
    required this.child,
    required this.palette,
    this.padding = const EdgeInsets.all(18),
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: padding,
      decoration: BoxDecoration(
        color: palette.isDark
            ? Colors.white.withOpacity(.06)
            : Colors.white,
        borderRadius: BorderRadius.circular(20),
        border: Border.all(color: palette.cardBorder),
        boxShadow: [
          BoxShadow(
            color: palette.isDark
                ? Colors.black.withOpacity(.25)
                : const Color(0xFFD8C79A).withOpacity(.4),
            blurRadius: 18,
            offset: const Offset(0, 10),
          ),
        ],
      ),
      child: child,
    );
  }
}

InputDecoration glassInputDecoration(
  Palette p,
  String label,
) {
  return InputDecoration(
    labelText: label,
    labelStyle: TextStyle(color: p.textSecondary),
    filled: true,
    fillColor: p.inputFill,
    enabledBorder: OutlineInputBorder(
      borderRadius: BorderRadius.circular(12),
      borderSide: BorderSide(color: p.cardBorder),
    ),
    focusedBorder: OutlineInputBorder(
      borderRadius: BorderRadius.circular(12),
      borderSide: BorderSide(color: p.gold, width: 1.5),
    ),
    border: OutlineInputBorder(
      borderRadius: BorderRadius.circular(12),
    ),
  );
}

Widget sectionHeader(
  Palette p,
  IconData icon,
  String title, {
  Widget? trailing,
}) {
  return Row(
    mainAxisAlignment: MainAxisAlignment.spaceBetween,
    children: [
      Row(
        children: [
          Icon(icon, color: p.gold, size: 20),
          const SizedBox(width: 8),
          Text(
            title,
            style: TextStyle(
              color: p.textPrimary,
              fontSize: 16,
              fontWeight: FontWeight.bold,
            ),
          ),
        ],
      ),
      if (trailing != null) trailing,
    ],
  );
}

// ============================================================
// التطبيق الرئيسي
// ============================================================

class CaptainZoneApp extends StatelessWidget {
  const CaptainZoneApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'كشف الطلبات',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        useMaterial3: true,
        fontFamily: 'Thmanyah',
        textTheme: ThemeData.light()
            .textTheme
            .apply(fontFamily: 'Thmanyah'),
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF0B1F3A),
        ),
      ),
      home: const RootShell(),
    );
  }
}

class RootShell extends StatefulWidget {
  const RootShell({super.key});

  @override
  State<RootShell> createState() => _RootShellState();
}

class _RootShellState extends State<RootShell> {
  bool isLoading = true;
  bool isDarkMode = true;
  int currentTab = 0;

  // الوردية الحالية
  bool shiftOpen = false;
  DateTime? shiftStartDate;
  int todayOrders = 0;
  double activeOrderPrice = SettingsData.orderPrice;

  // البيانات
  final List<DailyRecord> records = [];
  final List<MonthlyRentEntry> monthlyRents = [];
  final List<GasEntry> gasEntries = [];
  final List<OtherExpense> otherExpenses = [];

  int selectedMonth = DateTime.now().month;
  int selectedYear = DateTime.now().year;

  bool isGeneratingReport = false;
  ui.Image? logoImage;

  final List<String> monthNames = const [
    '',
    'يناير',
    'فبراير',
    'مارس',
    'أبريل',
    'مايو',
    'يونيو',
    'يوليو',
    'أغسطس',
    'سبتمبر',
    'أكتوبر',
    'نوفمبر',
    'ديسمبر',
  ];

  Palette get palette => Palette(isDarkMode);

  @override
  void initState() {
    super.initState();
    _loadAllData();
    _loadLogoImage();
  }

  // ============================================================
  // أدوات عامة
  // ============================================================

  void _showSnackBar(String message) {
    if (!mounted) return;

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(message)),
    );
  }

  Future<bool> _confirmDialog({
    required String title,
    required String message,
    String confirmText = 'تأكيد',
  }) async {
    final result = await showDialog<bool>(
      context: context,
      builder: (dialogContext) {
        return AlertDialog(
          backgroundColor: palette.dialogBg,
          title: Text(
            title,
            style: TextStyle(color: palette.textPrimary),
          ),
          content: Text(
            message,
            style: TextStyle(
              color: palette.textSecondary,
              height: 1.5,
            ),
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(dialogContext, false);
              },
              child: const Text('إلغاء'),
            ),
            ElevatedButton(
              onPressed: () {
                Navigator.pop(dialogContext, true);
              },
              child: Text(confirmText),
            ),
          ],
        );
      },
    );

    return result == true;
  }

  Future<DateTime?> _pickDate({
    required DateTime initialDate,
    DateTime? lastDate,
  }) {
    final today = dateOnly(DateTime.now());
    var safeInitial = dateOnly(initialDate);

    if (safeInitial.isAfter(today)) {
      safeInitial = today;
    }

    return showDatePicker(
      context: context,
      initialDate: safeInitial,
      firstDate: DateTime(2023, 1, 1),
      lastDate: lastDate ?? today,
    );
  }

  bool _isFutureDate(DateTime date) {
    return dateOnly(date).isAfter(
      dateOnly(DateTime.now()),
    );
  }

  // ============================================================
  // تحميل البيانات
  // ============================================================

  Future<void> _loadLogoImage() async {
    try {
      final data = await rootBundle.load(
        'assets/icon/icon.png',
      );

      final bytes = data.buffer.asUint8List();
      final codec = await ui.instantiateImageCodec(bytes);
      final frame = await codec.getNextFrame();

      if (!mounted) return;

      setState(() {
        logoImage = frame.image;
      });
    } catch (_) {
      logoImage = null;
    }
  }

  Future<void> _loadAllData() async {
    try {
      await SettingsData.load();

      final prefs = await SharedPreferences.getInstance();

      isDarkMode = prefs.getBool('isDarkMode') ?? true;

      final recordsJson = prefs.getString('records');

      if (recordsJson != null && recordsJson.isNotEmpty) {
        final decoded = jsonDecode(recordsJson);

        if (decoded is List) {
          records.addAll(
            decoded.map(
              (item) => DailyRecord.fromJson(
                Map<String, dynamic>.from(item),
              ),
            ),
          );
        }
      }

      final rentsJson = prefs.getString('monthlyRents');

      if (rentsJson != null && rentsJson.isNotEmpty) {
        final decoded = jsonDecode(rentsJson);

        if (decoded is List) {
          monthlyRents.addAll(
            decoded.map(
              (item) => MonthlyRentEntry.fromJson(
                Map<String, dynamic>.from(item),
              ),
            ),
          );
        }
      }

      if (monthlyRents.isEmpty) {
        monthlyRents.add(
          MonthlyRentEntry(
            year: DateTime.now().year,
            month: DateTime.now().month,
            amount: SettingsData.monthlyRent,
          ),
        );
      }

      final gasJson = prefs.getString('gasEntries');

      if (gasJson != null && gasJson.isNotEmpty) {
        final decoded = jsonDecode(gasJson);

        if (decoded is List) {
          gasEntries.addAll(
            decoded.map(
              (item) => GasEntry.fromJson(
                Map<String, dynamic>.from(item),
              ),
            ),
          );
        }
      }

      final otherJson = prefs.getString('otherExpenses');

      if (otherJson != null && otherJson.isNotEmpty) {
        final decoded = jsonDecode(otherJson);

        if (decoded is List) {
          otherExpenses.addAll(
            decoded.map(
              (item) => OtherExpense.fromJson(
                Map<String, dynamic>.from(item),
              ),
            ),
          );
        }
      }

      final activeShiftJson =
          prefs.getString('activeShift');

      if (activeShiftJson != null &&
          activeShiftJson.isNotEmpty) {
        final data = jsonDecode(activeShiftJson);

        shiftOpen = true;

        shiftStartDate = DateTime.parse(
          data['shiftStartDate'].toString(),
        );

        todayOrders =
            (data['ordersCount'] as num?)?.toInt() ?? 0;

        activeOrderPrice =
            (data['orderPrice'] as num?)?.toDouble() ??
                SettingsData.orderPrice;
      }

      await _saveAllData();

      if (!mounted) return;

      setState(() {
        isLoading = false;
      });

      if (shiftOpen && shiftStartDate != null) {
        WidgetsBinding.instance.addPostFrameCallback((_) {
          if (!mounted) return;

          _showSnackBar(
            'توجد وردية مفتوحة بدأت بتاريخ '
            '${DateFormat('yyyy-MM-dd').format(shiftStartDate!)}',
          );
        });
      }
    } catch (_) {
      if (!mounted) return;

      setState(() {
        isLoading = false;
      });

      _showSnackBar(
        'تعذر تحميل بعض البيانات المحفوظة',
      );
    }
  }

  // ============================================================
  // الحفظ
  // ============================================================

  Future<void> _saveRecords() async {
    final prefs = await SharedPreferences.getInstance();

    await prefs.setString(
      'records',
      jsonEncode(
        records.map((record) => record.toJson()).toList(),
      ),
    );
  }

  Future<void> _saveMonthlyRents() async {
    final prefs = await SharedPreferences.getInstance();

    await prefs.setString(
      'monthlyRents',
      jsonEncode(
        monthlyRents.map((rent) => rent.toJson()).toList(),
      ),
    );
  }

  Future<void> _saveGasEntries() async {
    final prefs = await SharedPreferences.getInstance();

    await prefs.setString(
      'gasEntries',
      jsonEncode(
        gasEntries.map((entry) => entry.toJson()).toList(),
      ),
    );
  }

  Future<void> _saveOtherExpenses() async {
    final prefs = await SharedPreferences.getInstance();

    await prefs.setString(
      'otherExpenses',
      jsonEncode(
        otherExpenses.map((expense) => expense.toJson()).toList(),
      ),
    );
  }

  Future<void> _saveAllData() async {
    await _saveRecords();
    await _saveMonthlyRents();
    await _saveGasEntries();
    await _saveOtherExpenses();
    await SettingsData.save();
  }

  Future<void> _saveActiveShift() async {
    if (shiftStartDate == null) return;

    final prefs = await SharedPreferences.getInstance();

    await prefs.setString(
      'activeShift',
      jsonEncode({
        'shiftStartDate':
            shiftStartDate!.toIso8601String(),
        'ordersCount': todayOrders,
        'orderPrice': activeOrderPrice,
      }),
    );
  }

  Future<void> _clearActiveShift() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.remove('activeShift');
  }

  // ============================================================
  // البحث والتحديث
  // ============================================================

  DailyRecord? _recordForDate(DateTime date) {
    for (final record in records) {
      if (isSameDay(record.date, date)) {
        return record;
      }
    }

    return null;
  }

  MonthlyRentEntry? _rentForMonth(
    int year,
    int month,
  ) {
    for (final rent in monthlyRents) {
      if (rent.year == year && rent.month == month) {
        return rent;
      }
    }

    return null;
  }

  double _rentAmountForMonth(
    int year,
    int month,
  ) {
    final savedRent = _rentForMonth(year, month);

    if (savedRent != null) {
      return savedRent.amount;
    }

    final now = DateTime.now();

    if (year == now.year && month == now.month) {
      return SettingsData.monthlyRent;
    }

    return 0.0;
  }

  void _upsertRecord(DailyRecord newRecord) {
    records.removeWhere(
      (record) => isSameDay(
        record.date,
        newRecord.date,
      ),
    );

    records.add(newRecord);
  }

  void _upsertRent(MonthlyRentEntry newRent) {
    final index = monthlyRents.indexWhere(
      (rent) =>
          rent.year == newRent.year &&
          rent.month == newRent.month,
    );

    if (index >= 0) {
      monthlyRents[index] = newRent;
    } else {
      monthlyRents.add(newRent);
    }
  }

  // ============================================================
  // الوردية
  // ============================================================

  Future<void> startNewShift() async {
    if (shiftOpen) {
      _showSnackBar('توجد وردية مفتوحة بالفعل');
      return;
    }

    setState(() {
      shiftOpen = true;
      shiftStartDate = DateTime.now();
      todayOrders = 0;
      activeOrderPrice = SettingsData.orderPrice;
    });

    await _saveActiveShift();

    _showSnackBar('بدأت وردية جديدة');
  }

  Future<void> incrementOrders() async {
    if (!shiftOpen) {
      _showSnackBar('ابدأ الوردية أولًا');
      return;
    }

    setState(() {
      todayOrders++;
    });

    await _saveActiveShift();
  }

  Future<void> decrementOrders() async {
    if (!shiftOpen) return;

    if (todayOrders <= 0) {
      _showSnackBar('لا يمكن أن يكون عدد الطلبات أقل من صفر');
      return;
    }

    setState(() {
      todayOrders--;
    });

    await _saveActiveShift();
  }

  Future<void> editShiftDate() async {
    if (!shiftOpen || shiftStartDate == null) return;

    final result = await _pickDate(
      initialDate: shiftStartDate!,
    );

    if (result == null) return;

    setState(() {
      shiftStartDate = dateOnly(result);
    });

    await _saveActiveShift();

    _showSnackBar('تم تعديل تاريخ بداية الوردية');
  }

  Future<void> finishWorkDay() async {
    if (!shiftOpen || shiftStartDate == null) {
      return;
    }

    final confirmed = await _confirmDialog(
      title: 'حفظ وإنهاء الوردية',
      message:
          'سيتم حفظ الوردية على تاريخ بدايتها:\n'
          '${DateFormat('yyyy-MM-dd').format(shiftStartDate!)}\n\n'
          'عدد الطلبات: $todayOrders\n'
          'سعر الطلب: ${money(activeOrderPrice)}\n\n'
          'هل تريد المتابعة؟',
      confirmText: 'حفظ وإنهاء',
    );

    if (!confirmed) return;

    final recordDate = dateOnly(shiftStartDate!);
    final oldRecord = _recordForDate(recordDate);

    if (oldRecord != null) {
      final replaceConfirmed = await _confirmDialog(
        title: 'استبدال سجل موجود',
        message:
            'يوجد سجل سابق لهذا التاريخ، وسيتم استبداله ببيانات الوردية الحالية. هل تريد المتابعة؟',
        confirmText: 'استبدال',
      );

      if (!replaceConfirmed) return;
    }

    final record = DailyRecord(
      date: recordDate,
      isWorkDay: true,
      ordersCount: todayOrders,
      orderPrice: activeOrderPrice,
    );

    setState(() {
      _upsertRecord(record);

      shiftOpen = false;
      shiftStartDate = null;
      todayOrders = 0;
      activeOrderPrice = SettingsData.orderPrice;
    });

    await _saveRecords();
    await _clearActiveShift();

    _showSnackBar(
      'تم حفظ الوردية ويمكنك بدء وردية جديدة الآن ✅',
    );
  }

  Future<void> markHoliday() async {
    if (shiftOpen) {
      _showSnackBar(
        'توجد وردية مفتوحة. أغلق الوردية الحالية أولًا.',
      );
      return;
    }

    final today = dateOnly(DateTime.now());
    final oldRecord = _recordForDate(today);

    if (oldRecord != null) {
      final confirmed = await _confirmDialog(
        title: 'استبدال سجل اليوم',
        message:
            'يوجد سجل محفوظ لليوم. هل تريد استبداله بيوم إجازة؟',
        confirmText: 'استبدال',
      );

      if (!confirmed) return;
    } else {
      final confirmed = await _confirmDialog(
        title: 'تسجيل إجازة',
        message: 'هل تريد تسجيل اليوم كإجازة؟',
        confirmText: 'تسجيل إجازة',
      );

      if (!confirmed) return;
    }

    setState(() {
      _upsertRecord(
        DailyRecord(
          date: today,
          isWorkDay: false,
          ordersCount: 0,
          orderPrice: SettingsData.orderPrice,
        ),
      );
    });

    await _saveRecords();

    _showSnackBar('تم تسجيل اليوم كإجازة');
  }

  // ============================================================
  // الحسابات والإحصائيات
  // ============================================================

  List<DailyRecord> _recordsFor(
    int year,
    int month,
  ) {
    final list = records
        .where(
          (record) =>
              record.date.year == year &&
              record.date.month == month,
        )
        .toList();

    list.sort(
      (a, b) => b.date.compareTo(a.date),
    );

    return list;
  }

  List<GasEntry> _gasFor(
    int year,
    int month,
  ) {
    final list = gasEntries
        .where(
          (entry) =>
              entry.date.year == year &&
              entry.date.month == month,
        )
        .toList();

    list.sort(
      (a, b) => b.date.compareTo(a.date),
    );

    return list;
  }

  List<OtherExpense> _otherFor(
    int year,
    int month,
  ) {
    final list = otherExpenses
        .where(
          (expense) =>
              expense.date.year == year &&
              expense.date.month == month,
        )
        .toList();

    list.sort(
      (a, b) => b.date.compareTo(a.date),
    );

    return list;
  }

  List<DailyRecord> get filteredRecords {
    return _recordsFor(
      selectedYear,
      selectedMonth,
    );
  }

  List<GasEntry> get filteredGasEntries {
    return _gasFor(
      selectedYear,
      selectedMonth,
    );
  }

  List<OtherExpense> get filteredOtherExpenses {
    return _otherFor(
      selectedYear,
      selectedMonth,
    );
  }

  int get monthlyOrders {
    return filteredRecords.fold(
      0,
      (sum, record) => sum + record.ordersCount,
    );
  }

  double get monthlyGross {
    return filteredRecords.fold(
      0.0,
      (sum, record) => sum + record.grossIncome,
    );
  }

  double get monthlyRent {
    return _rentAmountForMonth(
      selectedYear,
      selectedMonth,
    );
  }

  double get monthlyCompanyGas {
    return filteredGasEntries
        .where((entry) => entry.isCompany)
        .fold(
          0.0,
          (sum, entry) => sum + entry.amount,
        );
  }

  double get monthlyPersonalGas {
    return filteredGasEntries
        .where((entry) => !entry.isCompany)
        .fold(
          0.0,
          (sum, entry) => sum + entry.amount,
        );
  }

  double get monthlyOtherExpenses {
    return filteredOtherExpenses.fold(
      0.0,
      (sum, expense) => sum + expense.amount,
    );
  }

  double get monthlyNet {
    return monthlyGross -
        monthlyRent -
        monthlyCompanyGas -
        monthlyPersonalGas -
        monthlyOtherExpenses;
  }

  MonthStats _statsFor(
    int year,
    int month,
  ) {
    final targetRecords = _recordsFor(year, month);
    final targetGas = _gasFor(year, month);
    final targetOther = _otherFor(year, month);

    final orders = targetRecords.fold(
      0,
      (sum, record) => sum + record.ordersCount,
    );

    final gross = targetRecords.fold(
      0.0,
      (sum, record) => sum + record.grossIncome,
    );

    final rent = _rentAmountForMonth(year, month);

    final companyGas = targetGas
        .where((entry) => entry.isCompany)
        .fold(
          0.0,
          (sum, entry) => sum + entry.amount,
        );

    final personalGas = targetGas
        .where((entry) => !entry.isCompany)
        .fold(
          0.0,
          (sum, entry) => sum + entry.amount,
        );

    final otherExpenses = targetOther.fold(
      0.0,
      (sum, expense) => sum + expense.amount,
    );

    return MonthStats(
      orders: orders,
      gross: gross,
      rent: rent,
      companyGas: companyGas,
      personalGas: personalGas,
      otherExpenses: otherExpenses,
    );
  }

  Map<int, double> _dailyGrossSeries(
    int year,
    int month,
  ) {
    final result = <int, double>{};

    for (final record in _recordsFor(year, month)) {
      result[record.date.day] =
          (result[record.date.day] ?? 0) +
              record.grossIncome;
    }

    return result;
  }

  MonthStats get previousMonthStats {
    var previousMonth = selectedMonth - 1;
    var previousYear = selectedYear;

    if (previousMonth < 1) {
      previousMonth = 12;
      previousYear--;
    }

    return _statsFor(
      previousYear,
      previousMonth,
    );
  }

  bool get hasPreviousMonthData {
    var previousMonth = selectedMonth - 1;
    var previousYear = selectedYear;

    if (previousMonth < 1) {
      previousMonth = 12;
      previousYear--;
    }

    return _recordsFor(previousYear, previousMonth).isNotEmpty ||
        _gasFor(previousYear, previousMonth).isNotEmpty ||
        _otherFor(previousYear, previousMonth).isNotEmpty ||
        _rentForMonth(previousYear, previousMonth) != null;
  }

  double get previousMonthNet {
    return previousMonthStats.net;
  }

  // ============================================================
  // تغيير الشهر والسنة
  // ============================================================

  void changeMonth(int value) {
    setState(() {
      selectedMonth = value;
    });
  }

  void changeYear(int value) {
    setState(() {
      selectedYear += value;
    });
  }

